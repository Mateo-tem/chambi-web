---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout title="Soporte | Chambi" description="Soporte y contacto de Chambi.">
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Soporte</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-midnight md:text-5xl">Soporte y contacto</h1>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-soft">
        <h2 class="text-xl font-bold text-midnight">Contacto</h2>
        <ul class="mt-6 space-y-4 text-slate-600">
          <li><strong class="text-midnight">Correo:</strong> <a href={`mailto:${siteConfig.supportEmail}`} class="text-accent">{siteConfig.supportEmail}</a></li>
          <li><strong class="text-midnight">Ciudad:</strong> Lima, Perú</li>
        </ul>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-soft">
        <h2 class="text-xl font-bold text-midnight">Temas de ayuda</h2>
        <ul class="mt-6 space-y-3 text-slate-600">
          <li>Reportar problemas técnicos</li>
          <li>Reportar usuarios</li>
          <li>Solicitar eliminación de cuenta</li>
          <li>Solicitar eliminación de datos</li>
          <li>Reportar contenido</li>
          <li>Consultas de privacidad</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
