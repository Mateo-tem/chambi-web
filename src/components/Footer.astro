---
const legalLinks = [
  { label: 'Términos y condiciones', href: '/terminos' },
  { label: 'Política de privacidad', href: '/privacidad' },
];

const navLinks = [
  { label: 'Inicio', href: '/#inicio' },
  { label: '¿Cómo funciona?', href: '/#como-funciona' },
  { label: 'Para clientes', href: '/#clientes' },
  { label: 'Para trabajadores', href: '/#trabajadores' },
  { label: 'FAQ', href: '/#faq' },
];
---
<footer class="bg-midnight text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <img src="/Chambi_Logo_Slogan.svg" alt="Chambi" class="h-14 w-auto object-contain" />
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Navegación</h3>
        <ul class="mt-5 space-y-3 text-sm text-slate-300">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="transition hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Legal</h3>
        <ul class="mt-5 space-y-3 text-sm text-slate-300">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="transition hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Síguenos</h3>
        <a
          href="https://www.instagram.com/chambi_pe"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram de Chambi"
          class="mt-5 inline-flex text-slate-300 transition hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-slate-800 pt-6 text-sm text-slate-400">
      © 2026 Chambi
    </div>
  </div>
</footer>
