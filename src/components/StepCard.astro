---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props as Props;
---
<div class="rounded-3xl border border-slate-700 bg-slate-900/70 p-6 shadow-sm">
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent">{number}</p>
  <h3 class="mt-4 text-xl font-semibold text-white">{title}</h3>
  <p class="mt-3 text-sm leading-6 text-slate-300">{description}</p>
</div>
