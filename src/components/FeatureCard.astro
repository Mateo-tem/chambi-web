---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props as Props;
---
<div class="rounded-3xl border border-slate-700 bg-slate-900/70 p-6 shadow-soft">
  <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500/10 text-xl text-accent">
    {icon}
  </div>
  <h3 class="text-xl font-semibold text-white">{title}</h3>
  <p class="mt-3 text-sm leading-6 text-slate-300">{description}</p>
</div>
