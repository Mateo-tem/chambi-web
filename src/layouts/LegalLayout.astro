---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
}

const { title, description = 'Información legal de Chambi.', lastUpdated } = Astro.props as Props;
---
<BaseLayout title={title} description={description}>
  <section class="relative overflow-hidden bg-slate-950 py-16 text-white sm:py-20">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_10%,rgba(249,115,22,0.22),transparent_40%),radial-gradient(circle_at_85%_0%,rgba(59,130,246,0.18),transparent_45%),radial-gradient(circle_at_10%_100%,rgba(15,23,42,0.92),transparent_45%),radial-gradient(circle_at_95%_70%,rgba(249,115,22,0.1),transparent_42%)]"></div>
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent">Legal</p>
      <div class="mt-4 max-w-3xl">
        <h1 class="text-4xl font-black tracking-tight text-white md:text-5xl">{title}</h1>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-300 sm:mt-4 md:text-lg">
          Documento oficial de Chambi. Te recomendamos revisar cada sección con atención para conocer el alcance de nuestros términos y políticas.
          {lastUpdated && <span class="block text-sm font-semibold text-slate-200 sm:text-base">Última actualización: {lastUpdated}</span>}
        </p>
      </div>
      <div class="legal-content mt-8 sm:mt-10">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
