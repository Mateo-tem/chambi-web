---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.meta.title,
  description = siteConfig.meta.description,
} = Astro.props as Props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <title>{title}</title>
  </head>
  <body class="bg-midnight text-midnight">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { inject } from '@vercel/analytics';
      inject();
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const menuButton = document.querySelector('[data-nav-toggle]');
      const mobileMenu = document.getElementById('mobile-menu');

      if (menuButton && mobileMenu) {
        menuButton.addEventListener('click', () => {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          menuButton.setAttribute('aria-expanded', String(!isExpanded));
          mobileMenu.setAttribute('aria-hidden', String(isExpanded));
          mobileMenu.classList.toggle('pointer-events-none', isExpanded);
          mobileMenu.classList.toggle('opacity-0', isExpanded);
          mobileMenu.classList.toggle('translate-y-4', isExpanded);
          mobileMenu.classList.toggle('opacity-100', !isExpanded);
          mobileMenu.classList.toggle('translate-y-0', !isExpanded);
        });

        mobileMenu.querySelectorAll('.mobile-link').forEach((link) => {
          link.addEventListener('click', () => {
            menuButton.setAttribute('aria-expanded', 'false');
            mobileMenu.setAttribute('aria-hidden', 'true');
            mobileMenu.classList.add('pointer-events-none', 'opacity-0', 'translate-y-4');
            mobileMenu.classList.remove('opacity-100', 'translate-y-0');
          });
        });
      }

      if (!reduceMotion) {
        gsap.fromTo(
          '.hero-copy',
          { autoAlpha: 0, y: 24 },
          { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.12 }
        );

        gsap.fromTo(
          '.hero-visual',
          { autoAlpha: 0, y: 40, scale: 0.97 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 1, ease: 'power3.out', delay: 0.4 }
        );

        gsap.utils.toArray('.reveal').forEach((element) => {
          gsap.fromTo(
            element,
            { autoAlpha: 0, y: 24 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.75,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
              },
            }
          );
        });
      } else {
        document.querySelectorAll('.hero-copy, .hero-visual, .reveal').forEach((element) => {
          element.classList.remove('opacity-0');
          element.classList.add('opacity-100');
        });
      }
    </script>
  </body>
</html>
